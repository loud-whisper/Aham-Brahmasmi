{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/loud-whisper/Aham-Brahmasmi/third_party/registry.schema.json",
  "title": "Aham Brahmasmi third-party registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policy", "sources"],
  "properties": {
    "version": {"const": 1},
    "policy": {"const": "link-upstream"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "upstream_url",
        "source_type",
        "source_ref",
        "license",
        "license_url",
        "integration",
        "local_changes",
        "checked_at",
        "review_status",
        "role",
        "default_offer",
        "activation",
        "attribution",
        "notes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["skill-collection", "semantic-memory", "tool", "adapter-source"]},
        "upstream_url": {"type": "string", "pattern": "^https://"},
        "source_type": {"const": "git_commit"},
        "source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "minLength": 1},
        "license_url": {"type": "string", "pattern": "^https://"},
        "integration": {"enum": ["link", "installer", "adapter"]},
        "local_changes": {"type": "boolean"},
        "checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "review_status": {"enum": ["approved", "review-required", "disabled"]},
        "role": {"type": "string", "minLength": 1},
        "default_offer": {"type": "boolean"},
        "activation": {"enum": ["manual", "workspace_external", "runtime_adapter"]},
        "attribution": {"type": "string", "minLength": 1},
        "notes": {"type": "string"},
        "scanner_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "version", "executable", "version_args"],
          "properties": {
            "protocol": {"const": "aham-json-v1"},
            "version": {"type": "string", "minLength": 1},
            "executable": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\u0000]+$"},
            "version_args": {"type": "array", "minItems": 1, "maxItems": 8,
                             "items": {"type": "string", "maxLength": 200}}
          }
        },
        "local_adaptation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["based_on_ref", "summary", "changed_paths"],
          "properties": {
            "based_on_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "summary": {"type": "string", "minLength": 1},
            "changed_paths": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"required": ["scanner_adapter"]},
          "then": {"properties": {"kind": {"const": "tool"}, "integration": {"const": "adapter"}}}
        },
        {
          "if": {"properties": {"local_changes": {"const": true}}},
          "then": {"required": ["local_adaptation"]},
          "else": {"not": {"required": ["local_adaptation"]}}
        }
      ]
    }
  }
}
